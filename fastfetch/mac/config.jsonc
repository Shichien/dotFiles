{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "source": "Apple_small",
    "padding": { "top": 0, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "key": { "type": "string", "width": 11 }
  },

  "modules": [
    { "type": "title", "key": "用户", "keyColor": "#f5c2e7" },
    { "type": "separator", "string": "────────────────────", "color": "#45475a" },

    { "type": "cpu", "key": "CPU", "keyColor": "#f9e2af" },
    { "type": "gpu", "key": "GPU", "keyColor": "#f9e2af" },
    { "type": "memory", "key": "内存", "keyColor": "#f9e2af" },
    { "type": "disk", "key": "磁盘", "keyColor": "#f9e2af", "folders": "/", "format": "{1} / {2} ({3})" },
    { "type": "battery", "key": "电池", "keyColor": "#a6e3a1" },
    { "type": "localip", "key": "内网", "keyColor": "#89dceb" },

    { "type": "separator", "string": "────────────────────", "color": "#45475a" },
    { "type": "colors", "paddingLeft": 0, "symbol": "circle", "blockWidth": 2 }
  ]
}
